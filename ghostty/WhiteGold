# WhiteGold for Ghostty, part of cosmic-whitegold-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = WhiteGold
# or, with the DarkGold half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:DarkGold,light:WhiteGold

